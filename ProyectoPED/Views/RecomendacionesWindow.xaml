<Window x:Class="ProyectoPED.Views.RecomendacionesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recomendaciones y Análisis" Height="600" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">
    
    <Grid>
        <StackPanel Margin="20">
            
            <!-- Título -->
            <TextBlock Text="Análisis y Recomendaciones" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="#1F2937"
                       Margin="0,0,0,15"/>
            
            <!-- Pestaña de contenido -->
            <TabControl Background="White" BorderBrush="#E5E7EB" Foreground="#1F2937" Margin="0,0,0,15">
                
                <!-- Pestaña 1: Recomendaciones -->
                <TabItem Header="Recomendaciones" Foreground="#1F2937">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PnlRecomendaciones" Margin="15"/>
                    </ScrollViewer>
                </TabItem>
                
                <!-- Pestaña 2: Estadísticas -->
                <TabItem Header="Estadísticas" Foreground="#1F2937">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PnlEstadisticas" Margin="15"/>
                    </ScrollViewer>
                </TabItem>
                
                <!-- Pestaña 3: Cuellos de Botella -->
                <TabItem Header="Cuellos de Botella" Foreground="#1F2937">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PnlCuellos" Margin="15"/>
                    </ScrollViewer>
                </TabItem>
                
                <!-- Pestaña 4: Carga Diaria -->
                <TabItem Header="Carga de Trabajo" Foreground="#1F2937">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PnlCargaTrabajo" Margin="15"/>
                    </ScrollViewer>
                </TabItem>
                
            </TabControl>
            
            <!-- Botón Cerrar -->
            <Button Content="Cerrar" 
                    Click="BtnCerrar_Click"
                    Background="#8B5CF6" 
                    Foreground="White" 
                    Padding="16,10" 
                    FontWeight="SemiBold"
                    Width="150"
                    HorizontalAlignment="Center"/>
            
        </StackPanel>
    </Grid>
</Window>
