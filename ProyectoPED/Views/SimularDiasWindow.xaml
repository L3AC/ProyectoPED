<Window x:Class="ProyectoPED.Views.SimularDiasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Simular Avance de Días" Height="520" Width="520" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#F3F4F6">
    
    <Grid>
        <Border Background="White" CornerRadius="12" Margin="20">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="3" BlurRadius="15" Opacity="0.15" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="#8B5CF6" CornerRadius="12,12,0,0" Padding="25,20">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ClockFast" Width="28" Height="28" Foreground="White" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Simular Avance de Tiempo" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="Anticipa vencimientos y picos de carga" FontSize="12" Foreground="#C4B5FD" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Contenido -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="25,20">
                    <StackPanel>
                        <!-- Info de fecha actual -->
                        <Border Background="#EEF2FF" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarToday" Foreground="#6366F1" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtFechaActualInfo" FontSize="13" Foreground="#4338CA" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Opción 1: Simular por días -->
                        <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,15" Background="#FAFAFA">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Background="#8B5CF6" CornerRadius="20" Width="24" Height="24" HorizontalAlignment="Center">
                                        <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Simular por Días" FontSize="15" FontWeight="SemiBold" Foreground="#1F2937" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Avanzar" VerticalAlignment="Center" Foreground="#4B5563" FontSize="13"/>
                                    <TextBox x:Name="TxtCantidadDias" Grid.Column="1"
                                             Padding="10,8" FontSize="14" Text="1"
                                             Margin="10,0,10,0"
                                             VerticalContentAlignment="Center"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    <TextBlock Grid.Column="2" Text="días" VerticalAlignment="Center" Foreground="#4B5563" FontSize="13"/>
                                </Grid>
                                <Button Content="Simular Días" 
                                        Click="BtnSimularDias_Click"
                                        Background="#8B5CF6" 
                                        Foreground="White" 
                                        Padding="16,12" 
                                        MinWidth="160"
                                        Margin="0,12,0,0" 
                                        FontWeight="SemiBold"
                                        FontSize="13"
                                        Cursor="Hand"
                                        BorderThickness="0"
                                        HorizontalAlignment="Stretch">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" 
                                                    CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#7C3AED"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Opción 2: Simular hasta fecha -->
                        <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,15" Background="#FAFAFA">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Background="#6366F1" CornerRadius="20" Width="24" Height="24" HorizontalAlignment="Center">
                                        <TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Simular hasta Fecha" FontSize="15" FontWeight="SemiBold" Foreground="#1F2937" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Fecha:" VerticalAlignment="Center" Foreground="#4B5563" FontSize="13" Margin="0,0,10,0"/>
                                    <DatePicker x:Name="DtpFechaSimulacion" Grid.Column="1"
                                                Padding="10,8" FontSize="14"
                                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                                </Grid>
                                <Button Content="Simular hasta Fecha" 
                                        Click="BtnSimularFecha_Click"
                                        Background="#6366F1" 
                                        Foreground="White" 
                                        Padding="16,12" 
                                        MinWidth="160"
                                        Margin="0,12,0,0" 
                                        FontWeight="SemiBold"
                                        FontSize="13"
                                        Cursor="Hand"
                                        BorderThickness="0"
                                        HorizontalAlignment="Stretch">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" 
                                                    CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#4F46E5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Botón Cerrar -->
                <Border Grid.Row="2" Background="#F9FAFB" CornerRadius="0,0,12,12" Padding="25,15">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Padding="25,5"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Click="BtnCerrar_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
