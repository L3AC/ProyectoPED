<Window x:Class="ProyectoPED.Views.CambiarPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Cambiar Contraseña" Height="520" Width="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#F3F4F6">

    <Window.Resources>
        <Style x:Key="IndicatorBar" TargetType="Border">
            <Setter Property="Height" Value="6"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="White" CornerRadius="12" Margin="20">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="3" BlurRadius="15" Opacity="0.15" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#8B5CF6" CornerRadius="12,12,0,0" Padding="25,20">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="LockReset" Width="28" Height="28" Foreground="White" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Cambiar Contraseña" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="Asegura tu cuenta con una contraseña segura" FontSize="12" Foreground="#C4B5FD" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="25,20">
                    <StackPanel>
                        <!-- Contraseña actual -->
                        <TextBlock Text="Contraseña actual" FontSize="13" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <PasswordBox x:Name="PwbActual" Padding="12,10" FontSize="14"
                                     materialDesign:HintAssist.Hint="Ingresa tu contraseña actual"
                                     Style="{StaticResource MaterialDesignOutlinedPasswordBox}"/>

                        <!-- Nueva contraseña -->
                        <TextBlock Text="Nueva contraseña" FontSize="13" FontWeight="Medium" Foreground="#374151" Margin="0,20,0,8"/>
                        <PasswordBox x:Name="PwbNueva" Padding="12,10" FontSize="14"
                                     materialDesign:HintAssist.Hint="Mínimo 8 caracteres"
                                     PasswordChanged="PwbNueva_PasswordChanged"
                                     Style="{StaticResource MaterialDesignOutlinedPasswordBox}"/>

                        <!-- Indicador de seguridad -->
                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,12,0,15">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Seguridad:" FontSize="13" FontWeight="Medium" Foreground="#374151" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtNivelSeguridad" Text="Muy débil" FontSize="13" FontWeight="SemiBold" Foreground="#DC2626" Margin="8,0,0,0"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="Bar1" Grid.Column="0" Style="{StaticResource IndicatorBar}" Background="#E5E7EB"/>
                                    <Border x:Name="Bar2" Grid.Column="1" Style="{StaticResource IndicatorBar}" Background="#E5E7EB"/>
                                    <Border x:Name="Bar3" Grid.Column="2" Style="{StaticResource IndicatorBar}" Background="#E5E7EB"/>
                                    <Border x:Name="Bar4" Grid.Column="3" Style="{StaticResource IndicatorBar}" Background="#E5E7EB"/>
                                    <Border x:Name="Bar5" Grid.Column="4" Style="{StaticResource IndicatorBar}" Background="#E5E7EB" Margin="0"/>
                                </Grid>
                                <TextBlock x:Name="TxtInfoSeguridad" Text="Usa al menos 8 caracteres, mayúsculas, números y símbolos" FontSize="11" Foreground="#9CA3AF" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Confirmar contraseña -->
                        <TextBlock Text="Confirmar nueva contraseña" FontSize="13" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,8"/>
                        <PasswordBox x:Name="PwbConfirmar" Padding="12,10" FontSize="14"
                                     PasswordChanged="PwbConfirmar_PasswordChanged"
                                     materialDesign:HintAssist.Hint="Repite la nueva contraseña"
                                     Style="{StaticResource MaterialDesignOutlinedPasswordBox}"/>
                        <TextBlock x:Name="TxtConfirmacion" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Background="#F9FAFB" CornerRadius="0,0,12,12" Padding="25,15">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Padding="25,5" Margin="0,0,10,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Click="BtnCancelar_Click"/>
                        <Button x:Name="BtnGuardar" Content="Guardar Contraseña" Padding="25,5"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#8B5CF6"
                                IsEnabled="False"
                                Click="BtnGuardar_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
